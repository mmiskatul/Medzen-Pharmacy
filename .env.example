# ---------------------------------------------------------------- core
# Public origin, used for canonical URLs, sitemap and OpenGraph.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---------------------------------------------------------------- database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/medzen?schema=public"

# ---------------------------------------------------------------- auth
# 32+ random bytes. Generate with: openssl rand -base64 48
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
# Admin session lifetime in hours.
SESSION_TTL_HOURS="12"

# ---------------------------------------------------------------- jwt
# Primary HMAC secret used to sign every JWT (admin session, customer
# order status, magic-link / remember-me, API bearer tokens). Generate
# with: openssl rand -base64 48. Per-audience overrides below scope each
# flow to its own signing key, so a leak in one token class cannot
# forge a token in another.
JWT_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
JWT_ISSUER="medzen-pharmacy"
# /admin session cookie — replaces the opaque-token cookie. Longer-lived
# sessions multiply this by SESSION_TTL_HOURS*14 when "remember" is set.
AUD_ADMIN_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
AUD_ADMIN_TTL_HOURS="12"
# Customer order/prescription status lookup token (~6 months).
AUD_ORDER_STATUS_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
AUD_ORDER_STATUS_TTL_HOURS="4320"
# Customer magic-link (30 min) + remember-me (14 days).
AUD_CUSTOMER_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
AUD_MAGIC_LINK_TTL_MINUTES="30"
AUD_CUSTOMER_REMEMBER_TTL_HOURS="336"
# Staff API bearer tokens (90 days).
AUD_API_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
AUD_API_TTL_HOURS="2160"

# Development-only seed admin. Leave SEED_ADMIN_PASSWORD unset and the
# seed script generates a random password and prints it once.
SEED_ADMIN_EMAIL="admin@medzen.local"
SEED_ADMIN_PASSWORD=""

# ---------------------------------------------------------------- storage
# "local" writes to ./storage (never served statically), "cloudinary" uses the
# CLOUDINARY_* vars.
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage"
# Required when STORAGE_DRIVER="cloudinary". Get them from the Cloudinary
# console (Settings → Access Keys). Optional CLOUDINARY_FOLDER becomes the
# Cloudinary "folder" prefix every uploaded asset is scoped under — useful
# when sharing a cloud with other apps.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER=""

# Upload limits (bytes).
MAX_UPLOAD_BYTES="10485760"

# ---------------------------------------------------------------- email (optional)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="Medzen Pharmacy <no-reply@example.com>"

# ---------------------------------------------------------------- integrations
# Fallbacks only. The live values are edited in Admin -> Settings.
NEXT_PUBLIC_DEFAULT_WHATSAPP="971569970932"
NEXT_PUBLIC_MAPS_EMBED_URL=""
